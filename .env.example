# ── обязательные ───────────────────────────────────────────
# Postgres (docker compose поднимает сам; для локальной разработки: docker compose up -d db)
DATABASE_URL="postgresql://wbboard:wbboard@localhost:5432/wbboard"
POSTGRES_PASSWORD="wbboard"

# Секреты: сгенерировать `openssl rand -hex 32` (разные!)
AUTH_SECRET="change-me"
TOKEN_KEY="change-me-too"   # шифрование WB/MPstats-токенов в БД (ADR-006)

# ── WB-токены вводятся в UI (Настройки → Кабинеты), НЕ в env ──
# Тип «базовый», READ-ONLY, скоупы: Статистика, Аналитика, Продвижение, Контент, Цены, Финансы.
# Живут 180 дней — алерт за 14 дней придёт в TG.

# ── Telegram-алерты (опционально) ──────────────────────────
TG_BOT_TOKEN=""
TG_CHAT_ID_OWNER=""

# ── MPstats (опционально — без ключа модуль рынка в мок-режиме) ──
# Ключ удобнее вставить в UI: Настройки → Интеграции (хранится шифрованным в БД)
MPSTATS_TOKEN=""
# MPSTATS_MOCK="1"   # принудительный мок даже при наличии ключа

# ── Фото-чек (фаза 3) ──────────────────────────────────────
PHOTOCHECK_MOCK="1"          # 0 = живой пайплайн (нужны ключи OpenRouter/OTAPI — фаза 3)
PHOTOCHECK_TARGET_MARG="0.15"
PHOTOCHECK_CARGO_RUB="35"

# ── оценки для live P&L (пока нет факта финотчёта) ─────────
EST_LOGISTICS_RUB="55"
EST_STORAGE_RUB="6"
FX_ALERT_PCT="5"

# ── сид ────────────────────────────────────────────────────
SEED_ADMIN_PASSWORD="wbboard123"
SEED_DEMO="1"                # 0 = только роли и пользователи, без демо-данных

# Налоговый профиль по умолчанию (УСН «Доходы» 2% + НДС 7% без вычетов, Калмыкия)
TAX_MODE="usn_vat7"
